{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifacts/schemas/docs-index.schema.json",
  "title": "ComfyUI StarChart docs-index support artifact",
  "description": "Bounded structure for the checked-in docs-index.json support artifact used for navigation-aware docs discovery with optional tooling-task enrichment.",
  "type": "object",
  "required": [
    "artifact",
    "artifact_schema_version",
    "scope",
    "pages"
  ],
  "properties": {
    "artifact": {
      "type": "string"
    },
    "artifact_schema_version": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "surface",
        "excludes"
      ],
      "properties": {
        "surface": {
          "type": "string"
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "path",
          "nav_section",
          "audience",
          "evidence",
          "summary"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "nav_section": {
            "type": "string"
          },
          "audience": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "related_route_entries": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/related_route_entry"
            }
          },
          "route_classification_source": {
            "type": "string",
            "enum": [
              "metadata",
              "server_endpoints_crossref",
              "unknown"
            ]
          },
          "tooling_metadata": {
            "type": "object",
            "required": [
              "metadata_reviewed_at",
              "metadata_baseline",
              "task_intents",
              "primary_task_intents",
              "excluded_task_intents",
              "related_artifacts",
              "related_routes",
              "related_route_entries",
              "related_events",
              "runtime_required",
              "stability_tier",
              "recommended_next_reads",
              "inbound_recommendations"
            ],
            "properties": {
              "metadata_reviewed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "metadata_baseline": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "task_intents": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "primary_task_intents": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "excluded_task_intents": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "related_artifacts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "related_routes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "related_route_entries": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/related_route_entry"
                }
              },
              "related_events": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "runtime_required": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "stability_tier": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "recommended_next_reads": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "inbound_recommendations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "related_route_entry": {
      "type": "object",
      "required": [
        "route",
        "route_type",
        "route_classification_reason"
      ],
      "properties": {
        "route": {
          "type": "string"
        },
        "route_type": {
          "type": "string",
          "enum": [
            "alias",
            "canonical",
            "deprecated",
            "external",
            "feature_flag",
            "unknown"
          ]
        },
        "route_classification_reason": {
          "type": "string",
          "enum": [
            "crossref_ambiguous",
            "crossref_resolved",
            "crossref_route_missing",
            "metadata_and_crossref_conflict",
            "metadata_explicit",
            "metadata_not_provided"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
