{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifacts/schemas/docs-index.schema.json",
  "title": "ComfyUI StarChart docs-index support artifact",
  "description": "Bounded structure for the checked-in docs-index.json support artifact used for navigation-aware docs discovery with optional tooling-task enrichment.",
  "type": "object",
  "required": [
    "artifact",
    "artifact_schema_version",
    "scope",
    "pages"
  ],
  "properties": {
    "artifact": {
      "type": "string"
    },
    "artifact_schema_version": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "surface",
        "excludes"
      ],
      "properties": {
        "surface": {
          "type": "string"
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "path",
          "nav_section",
          "audience",
          "evidence",
          "summary"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "nav_section": {
            "type": "string"
          },
          "audience": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "tooling_metadata": {
            "type": "object",
            "required": [
              "task_intents",
              "related_artifacts",
              "related_routes",
              "related_events",
              "runtime_required",
              "stability_tier",
              "recommended_next_reads"
            ],
            "properties": {
              "task_intents": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "related_artifacts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "related_routes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "related_events": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "runtime_required": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "stability_tier": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "recommended_next_reads": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
