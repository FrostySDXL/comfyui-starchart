{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifacts/schemas/node_api_schema.schema.json",
  "title": "ComfyUI StarChart node_api_schema artifact",
  "description": "Bounded guaranteed structure for the published node_api_schema.json artifact. Rich typed-detail enrichment remains optional unless explicitly listed here.",
  "type": "object",
  "required": [
    "metadata",
    "object_info_fields",
    "io_types",
    "basic_input_shapes",
    "v3_schema_contract",
    "coverage"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "sources",
        "extracted_date",
        "version",
        "commit"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extracted_date": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "object_info_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "io_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "io_type",
          "class_name",
          "input_class",
          "input_parameters",
          "type_hint",
          "defined_in"
        ],
        "properties": {
          "io_type": {
            "type": "string"
          },
          "class_name": {
            "type": "string"
          },
          "input_class": {
            "type": [
              "string",
              "null"
            ]
          },
          "input_parameters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "prompt_conditioning_surface": {
      "type": "object",
      "additionalProperties": true
    },
    "basic_input_shapes": {
      "type": "object",
      "additionalProperties": true
    },
    "typed_input_shapes": {
      "type": "object",
      "additionalProperties": true
    },
    "v3_schema_contract": {
      "type": "object",
      "required": [
        "contract_version",
        "schema_fields",
        "node_info_fields",
        "hidden_values",
        "price_badge_contract",
        "node_flags"
      ],
      "properties": {
        "contract_version": {
          "const": "3.0"
        },
        "schema_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/v3_dataclass_field"
          }
        },
        "node_info_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/v3_dataclass_field"
          }
        },
        "hidden_values": {
          "type": "object",
          "required": [
            "hidden_enum",
            "hidden_auto_injection"
          ],
          "properties": {
            "hidden_enum": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "defined_in",
                  "traceability"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "defined_in": {
                    "type": "string"
                  },
                  "traceability": {
                    "type": "object"
                  }
                },
                "additionalProperties": true
              }
            },
            "hidden_auto_injection": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "condition",
                  "injected"
                ],
                "properties": {
                  "condition": {
                    "type": "string"
                  },
                  "injected": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "price_badge_contract": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "class_name",
              "fields",
              "traceability"
            ],
            "properties": {
              "class_name": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/v3_dataclass_field"
                }
              },
              "traceability": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        },
        "node_flags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "schema_fields_ref"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "schema_fields_ref": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "required": [
        "description",
        "sources_covered",
        "runtime_enriched",
        "deferred"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "sources_covered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime_enriched": {
          "type": "boolean"
        },
        "guaranteed_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
            "minLength": 1
          }
        },
        "best_effort_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
            "minLength": 1
          }
        },
        "deferred": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "v3_dataclass_field": {
      "type": "object",
      "required": [
        "name",
        "required",
        "defined_in",
        "traceability"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type_hint": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "default_factory": {
          "type": "string"
        },
        "default_expression": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "defined_in": {
          "type": "string"
        },
        "traceability": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
