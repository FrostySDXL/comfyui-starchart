{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifacts/schemas/delta-summary.schema.json",
  "title": "ComfyUI StarChart delta-summary support artifact",
  "description": "Bounded structure for the checked-in delta-summary.json support artifact that compares two canonical extracted baselines.",
  "type": "object",
  "required": [
    "comparison",
    "notes",
    "artifacts"
  ],
  "properties": {
    "comparison": {
      "type": "object",
      "required": [
        "old",
        "new",
        "methodology"
      ],
      "properties": {
        "old": {
          "type": "string"
        },
        "new": {
          "type": "string"
        },
        "methodology": {
          "type": "string"
        },
        "source_kind": {
          "type": "string"
        },
        "old_label": {
          "type": "string"
        },
        "new_label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "server_endpoints",
        "js_hooks",
        "node_api_schema",
        "websocket_events"
      ],
      "properties": {
        "server_endpoints": {
          "$ref": "#/$defs/deltaBlock"
        },
        "js_hooks": {
          "$ref": "#/$defs/deltaBlock"
        },
        "node_api_schema": {
          "type": "object",
          "required": [
            "object_info_fields",
            "io_types",
            "typed_input_shapes",
            "prompt_conditioning_surface",
            "basic_input_shapes"
          ],
          "properties": {
            "object_info_fields": {
              "$ref": "#/$defs/deltaBlock"
            },
            "io_types": {
              "$ref": "#/$defs/deltaBlock"
            },
            "typed_input_shapes": {
              "$ref": "#/$defs/deltaBlock"
            },
            "prompt_conditioning_surface": {
              "type": "object",
              "required": [
                "text_input_io_types",
                "conditioning_io_types"
              ],
              "properties": {
                "text_input_io_types": {
                  "$ref": "#/$defs/deltaBlock"
                },
                "conditioning_io_types": {
                  "$ref": "#/$defs/deltaBlock"
                }
              },
              "additionalProperties": false
            },
            "basic_input_shapes": {
              "$ref": "#/$defs/deltaBlock"
            }
          },
          "additionalProperties": false
        },
        "websocket_events": {
          "type": "object",
          "required": [
            "events",
            "binary_events"
          ],
          "properties": {
            "events": {
              "$ref": "#/$defs/deltaBlock"
            },
            "binary_events": {
              "$ref": "#/$defs/deltaBlock"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "deltaBlock": {
      "type": "object",
      "required": [
        "old_count",
        "new_count",
        "added",
        "removed",
        "changed"
      ],
      "properties": {
        "old_count": {
          "type": "integer"
        },
        "new_count": {
          "type": "integer"
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
