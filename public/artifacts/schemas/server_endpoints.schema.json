{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifacts/schemas/server_endpoints.schema.json",
  "title": "ComfyUI StarChart server_endpoints artifact",
  "description": "Bounded guaranteed structure for the published server_endpoints.json artifact. Best-effort descriptive fields remain optional and may evolve independently.",
  "type": "object",
  "required": [
    "metadata",
    "coverage",
    "endpoints",
    "prompt_submission_contract",
    "prompt_validation_errors",
    "queue_history_contract"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "sources",
        "extracted_date",
        "version",
        "commit"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extracted_date": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "required": [
        "description",
        "guaranteed_fields",
        "best_effort_fields",
        "deferred"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "guaranteed_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "best_effort_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deferred": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "route",
          "method",
          "returns"
        ],
        "properties": {
          "route": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "returns": {
            "type": "object",
            "required": [
              "kind",
              "status_codes"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "status_codes": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "prompt_submission_contract": {
      "type": "object",
      "required": [
        "request_fields",
        "success_response_fields",
        "error_response_fields"
      ],
      "properties": {
        "request_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contractField"
          }
        },
        "success_response_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contractField"
          }
        },
        "error_response_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contractField"
          }
        }
      },
      "additionalProperties": true
    },
    "prompt_validation_errors": {
      "type": "object",
      "required": [
        "error_types"
      ],
      "properties": {
        "error_types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "source_function",
              "traceability",
              "extraction_method"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "source_function": {
                "type": "string"
              },
              "traceability": {
                "$ref": "#/$defs/traceability"
              },
              "extraction_method": {
                "type": "string"
              },
              "extra_info_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "queue_history_contract": {
      "type": "object",
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "summary",
              "traceability"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "traceability": {
                "$ref": "#/$defs/traceability"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "contractField": {
      "type": "object",
      "required": [
        "name",
        "traceability"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "type_hint": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "traceability": {
          "$ref": "#/$defs/traceability"
        }
      },
      "additionalProperties": true
    },
    "traceability": {
      "type": "object",
      "required": [
        "source_type",
        "strategy"
      ],
      "properties": {
        "source_type": {
          "type": "string"
        },
        "strategy": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "source_function": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
