{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifacts/schemas/manifest.schema.json",
  "title": "ComfyUI Knowledge Base artifact manifest support artifact",
  "description": "Bounded structure for the checked-in manifest.json support artifact that advertises published artifact locations and checksums.",
  "type": "object",
  "required": [
    "artifact_schema_version",
    "version_key",
    "schemas",
    "artifacts"
  ],
  "properties": {
    "artifact_schema_version": {
      "type": "string"
    },
    "version_key": {
      "type": "string"
    },
    "schemas": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "schema_url"
        ],
        "properties": {
          "schema_url": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "current_url",
          "versioned_url",
          "sha256",
          "version",
          "commit",
          "extracted_date",
          "sources"
        ],
        "properties": {
          "current_url": {
            "type": "string"
          },
          "versioned_url": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "extracted_date": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
