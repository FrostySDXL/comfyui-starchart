{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifacts/schemas/manifest.schema.json",
  "title": "ComfyUI StarChart manifest support artifact",
  "description": "Bounded structure for the manifest.json discovery artifact that enumerates canonical published artifacts, schema URLs, and checksums.",
  "type": "object",
  "required": [
    "artifact_schema_version",
    "version_key",
    "schemas",
    "artifacts"
  ],
  "properties": {
    "artifact_schema_version": {
      "type": "string"
    },
    "version_key": {
      "type": "string"
    },
    "schemas": {
      "type": "object",
      "required": [
        "server_endpoints.json",
        "js_hooks.json",
        "node_api_schema.json",
        "websocket_events.json"
      ],
      "properties": {
        "server_endpoints.json": {
          "$ref": "#/$defs/schemaEntry"
        },
        "js_hooks.json": {
          "$ref": "#/$defs/schemaEntry"
        },
        "node_api_schema.json": {
          "$ref": "#/$defs/schemaEntry"
        },
        "websocket_events.json": {
          "$ref": "#/$defs/schemaEntry"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": [
        "server_endpoints.json",
        "js_hooks.json",
        "node_api_schema.json",
        "websocket_events.json"
      ],
      "properties": {
        "server_endpoints.json": {
          "$ref": "#/$defs/artifactEntry"
        },
        "js_hooks.json": {
          "$ref": "#/$defs/artifactEntry"
        },
        "node_api_schema.json": {
          "$ref": "#/$defs/artifactEntry"
        },
        "websocket_events.json": {
          "$ref": "#/$defs/artifactEntry"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "schemaEntry": {
      "type": "object",
      "required": [
        "schema_url"
      ],
      "properties": {
        "schema_url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "artifactEntry": {
      "type": "object",
      "required": [
        "current_url",
        "versioned_url",
        "sha256",
        "version",
        "commit",
        "extracted_date",
        "sources"
      ],
      "properties": {
        "current_url": {
          "type": "string"
        },
        "versioned_url": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "extracted_date": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commits": {
          "type": "object",
          "required": [
            "core",
            "frontend"
          ],
          "properties": {
            "core": {
              "type": "string"
            },
            "frontend": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
