{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifacts/schemas/refresh-provenance.schema.json",
  "title": "ComfyUI StarChart refresh-provenance support artifact",
  "description": "Bounded structure for the checked-in refresh-provenance.json support artifact written by the snapshot refresh workflow.",
  "type": "object",
  "required": [
    "backup_location",
    "next_steps",
    "published",
    "refresh_date",
    "requested_versions",
    "resolved_commits",
    "runtime_object_info"
  ],
  "properties": {
    "backup_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_steps": {
      "type": "object",
      "required": [
        "publish_reference_artifacts_command",
        "verify_artifact_integrity_command",
        "delta_summary_command"
        ,"run_all_command"
      ],
      "properties": {
        "publish_reference_artifacts_command": {
          "type": "string"
        },
        "verify_artifact_integrity_command": {
          "type": "string"
        },
        "delta_summary_command": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_all_command": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "published": {
      "type": "object",
      "required": [
        "manifest_included",
        "provenance_path",
        "canonical_artifacts_updated_by_refresh",
        "delta_summary_updated_by_refresh"
      ],
      "properties": {
        "canonical_artifacts_updated_by_refresh": {
          "type": "boolean"
        },
        "delta_summary_updated_by_refresh": {
          "type": "boolean"
        },
        "manifest_included": {
          "type": "boolean"
        },
        "provenance_path": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "refresh_date": {
      "type": "string",
      "description": "Snapshot content date in operator local time (YYYY-MM-DD). May differ by one day from the backup_location UTC timestamp if the refresh pipeline crossed a UTC midnight boundary during execution."
    },
    "requested_versions": {
      "type": "object",
      "required": [
        "core",
        "frontend"
      ],
        "properties": {
          "core": {
            "type": [
              "string",
              "null"
            ]
          },
          "frontend": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
    },
    "resolved_commits": {
      "type": "object",
      "required": [
        "core",
        "frontend"
      ],
        "properties": {
          "core": {
            "type": [
              "string",
              "null"
            ]
          },
          "frontend": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
    },
    "runtime_object_info": {
      "type": "object",
      "required": [
        "merged_into_node_api_schema",
        "requested"
      ],
      "properties": {
        "merged_into_node_api_schema": {
          "type": "boolean"
        },
        "requested": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
